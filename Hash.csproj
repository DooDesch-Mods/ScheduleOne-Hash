<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared release hardening: strip Release debug info + assembly identity, cuts AV false positives. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />

  <!--
    hash - a terminal on the in-game phone, and the successor to the console autocomplete mod.

    The interface is Assets/hash/index.html + app.css + app.js, rendered by Sideload. This project is the game-side
    half, and it is where every decision lives: which commands exist, what arguments they take, which mod supplied
    them, how a line ranks, and what a command printed. The page draws and forwards, nothing more.

    Split so the interesting half can be tested in a second rather than in a game launch:

      Terminal/   the shell - parsing a line, ranking a match, choosing a completion, formatting a block.
                  References NO engine assembly, which is what the headless suite enforces by compiling it alone.
      Game/       everything that has to ask the running game: the command index, the argument providers, the mod
                  attribution, the log capture, the console key.

    The two meet at the interfaces in Terminal/Ports.cs and nowhere else.

    Sideload itself is never referenced - only the single-file Sideload.Api shim, which finds the host by reflection.
    Sideload IS a hard requirement to use hash (there is no fallback UI and no home-screen icon: the console key is
    the only way in), which is why Core refuses to hijack the key when the host is too old to raise the phone.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hash</RootNamespace>
    <AssemblyName>Hash</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <NoWarn>$(NoWarn);MSB3277;MSB3245</NoWarn>

    <WorkspaceLibPath Condition="'$(WorkspaceLibPath)' == ''">$(MSBuildThisFileDirectory)../Workspace/lib</WorkspaceLibPath>
    <ModsDirectory Condition="'$(ModsDirectory)' == ''">$(MSBuildThisFileDirectory)../_MPTest/Schedule I/Mods</ModsDirectory>
  </PropertyGroup>

  <!-- On CI the build-libs repo is checked out into ./Workspace; keep that tree out of the default compile glob. -->
  <ItemGroup>
    <Compile Remove="Workspace/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(WorkspaceLibPath)/il2cpp/melonloader/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WorkspaceLibPath)/il2cpp/melonloader/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(WorkspaceLibPath)/il2cpp/melonloader/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppScheduleOne.Core">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2CppScheduleOne.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The mark casts a ray to find what the player is looking at. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GUIUtility.systemCopyBuffer, for `copy`. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only for InstanceFinder: the console is host-only and the terminal has to say so rather than go quiet. -->
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(WorkspaceLibPath)/il2cpp/game/Il2CppFishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The shim as SOURCE rather than as a second DLL: one file, one assembly to install.
       Two locations for the same file - the sibling project in the development monorepo, and the copy that ships in
       the private build-libs repo for a standalone checkout (and therefore CI). -->
  <PropertyGroup>
    <SideloadShimPath Condition="Exists('$(MSBuildThisFileDirectory)../Sideload/Sideload.Api/Sideload.cs')">$(MSBuildThisFileDirectory)../Sideload/Sideload.Api/Sideload.cs</SideloadShimPath>
    <SideloadShimPath Condition="'$(SideloadShimPath)' == '' And Exists('$(MSBuildThisFileDirectory)../Sideload.Api/Sideload.cs')">$(MSBuildThisFileDirectory)../Sideload.Api/Sideload.cs</SideloadShimPath>
    <SideloadShimPath Condition="'$(SideloadShimPath)' == '' And Exists('$(WorkspaceLibPath)/sideload-api/Sideload.cs')">$(WorkspaceLibPath)/sideload-api/Sideload.cs</SideloadShimPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Condition="'$(SideloadShimPath)' != ''" Include="$(SideloadShimPath)" Link="Sideload.Api.cs" />
  </ItemGroup>

  <!-- The web bundle. The logical name prefix is what Apps.Register is given.
       preview.html and s1-mock.js are authoring tools, not part of the app: they let the same files run in Chrome
       without a game launch, and shipping them inside the DLL would be dead weight. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/hash/*" Exclude="Assets/hash/preview.html;Assets/hash/s1-mock.js">
      <LogicalName>Hash.Assets.hash.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Condition="Exists('$(ModsDirectory)')" Command="cmd /c if exist &quot;$(ModsDirectory)&quot; copy /Y &quot;$(TargetPath)&quot; &quot;$(ModsDirectory)&quot;" ContinueOnError="true" />
  </Target>

</Project>
